---
import type { CollectionEntry } from "astro:content";
import { Font } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import ArticleStructuredData from "@/components/ArticleStructuredData.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, summary, pubDate, updatedDate } = Astro.props;
---

<!-- to reduce load time -->
<Font cssVariable="--font-mono" preload />

<Layout {title} description={summary ?? undefined} {pubDate} {updatedDate}>
  <ArticleStructuredData
    slot="structured-data"
    {title}
    description={summary}
    {pubDate}
    {updatedDate}
  />
  <article>
    <header class="mb-6">
      <h1
        class="mb-6 text-3xl font-bold text-stone-800 sm:text-4xl dark:text-stone-100"
      >
        {title}
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-300">
        {updatedDate ? "Updated on: " : "Published on: "}
        <FormattedDate date={updatedDate ?? pubDate} />
      </p>
    </header>
    <div
      class="prose prose-stone prose-a:text-sky-700 prose-a:underline prose-a:decoration-1 prose-a:underline-offset-2 prose-a:transition prose-a:hover:text-sky-800 prose-code:font-normal lg:prose-lg dark:prose-invert dark:prose-a:text-sky-300 dark:prose-a:hover:text-sky-200 mt-12 sm:mt-16"
    >
      <slot />
    </div>
  </article>
</Layout>
