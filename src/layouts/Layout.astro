---
import type { ImageMetadata } from "astro";
import { Font, Image } from "astro:assets";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import "@/styles/globals.css";
import FallbackImage from "@/assets/gravy.webp";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  pubDate?: Date;
  updatedDate?: Date | null;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title = "Gravy59",
  description = "Student dev who enjoys free software",
  image = FallbackImage,
  pubDate,
  updatedDate,
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-body" />

    <Font cssVariable="--font-mono" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Gravy59" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image.src, Astro.url)} />

    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }

    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@gravy59_" />
    <meta property="twitter:image" content={new URL(image.src, Astro.url)} />

  <slot name="structured-data" />

    {
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
  </head>
  <body
    class="bg-white px-6 py-4 font-(family-name:--font-body) dark:bg-stone-950"
  >
    <div
      aria-hidden
      class="user-select-none pointer-events-none fixed top-0 left-0 z-10 h-25 w-full bg-gradient-to-t from-transparent to-white mask-b-from-25% opacity-95 backdrop-blur-[5px] will-change-transform dark:to-stone-950"
    >
    </div>
    <header class="mt-8 mb-12 border-b text-stone-800 dark:text-stone-200">
      <div class="flex items-baseline gap-x-2 px-1.5 pb-1.5 leading-none">
        <a href="/" class="italic"> Gravy59 </a>
      </div>
    </header>

    <main class="w-full max-w-168">
      <slot />
    </main>
    <footer class="mt-16 text-stone-400 dark:text-stone-500">
      <small
        >Content on this website is licensed under <a
          class="font-semibold text-sky-500 underline-offset-[0.15em] hover:underline hover:decoration-1"
          href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a
        > unless otherwise stated.</small
      >
    </footer>
  </body>
</html>
